<section class="section collection"><p class="eyebrow">THE ESSAINT WARDROBE</p><h1>{{ collection.title }}</h1><div class="rte">{{ collection.description }}</div><form class="filter-bar" method="get"><span>{{ collection.products_count }} pieces</span><label>Sort by <select name="sort_by" onchange="this.form.submit()">{% assign sort = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></label></form>{% paginate collection.products by 24 %}<div class="product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>No pieces in this collection yet.</p>{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</section>
{% schema %}{"name": "Main Collection", "settings": [], "presets": [{"name": "Main Collection"}]}{% endschema %}