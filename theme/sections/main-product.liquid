<section class="section product-page"><div class="gallery">{% for image in product.images %}{{ image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500,900,1400', sizes: '(min-width: 900px) 55vw, 100vw' }}{% endfor %}</div><div class="product-details"><a class="eyebrow" href="{{ routes.all_products_collection_url }}">THE COLLECTION /</a><h1>{{ product.title }}</h1><div class="price" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</div>{% form 'product', product, class: 'native-product-form' %}<label for="variant-{{ section.id }}">Choose your size / color</label><select id="variant-{{ section.id }}" name="id" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price }}" {% unless variant.available %}disabled{% endunless %} {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select><label for="quantity">Quantity</label><input id="quantity" name="quantity" type="number" value="1" min="1" max="99"><button class="button" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag ↗{% else %}Sold out{% endif %}</button>{{ form | payment_button }}{% endform %}<details open><summary>The details</summary><div class="rte">{{ product.description }}</div></details><details><summary>Delivery & exchanges</summary><p>Complimentary shipping on orders over $100. 7-day easy exchanges.</p><a href="{{ shop.shipping_policy.url }}">Shipping policy</a> · <a href="{{ shop.refund_policy.url }}">Exchange policy</a></details><p class="fit-help">Need help choosing your fit? <a href="https://wa.me/96171236353">Ask us on WhatsApp ↗</a></p></div></section><script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}{"name": "Main Product", "settings": [], "presets": [{"name": "Main Product"}]}{% endschema %}