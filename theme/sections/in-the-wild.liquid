<section class="wild-section" id="in-the-wild"><div class="section-heading"><div><h2>WORN YOUR WAY</h2></div><a href="{{ routes.all_products_collection_url }}" class="text-link">SHOP THE LOOKS ↗</a></div><div class="wild-cards">{% for block in section.blocks %}{% assign piece = block.settings.product %}<article class="wild-card" {{ block.shopify_attributes }}><a href="{% if piece != blank %}{{ piece.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" {% if piece != blank %}data-product="{{ piece.handle }}"{% endif %} aria-label="{% if piece != blank %}Shop {{ piece.title | escape }}{% else %}Shop Essaint{% endif %}">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,600,900', sizes: '(min-width: 900px) 20vw, 65vw' }}{% else %}{% assign fallback = block.settings.asset %}<img src="{{ fallback | asset_url }}" width="900" height="1200" alt="{{ block.settings.caption | escape }}" loading="lazy">{% endif %}<span class="wild-shop">SHOP THIS LOOK <b>+</b></span></a><p>{{ block.settings.caption }}</p></article>{% endfor %}</div><div class="wild-bottom"><span>OFF THE RACK. OUT IN THE WORLD.</span><a class="text-link" href="https://wa.me/96171236353" target="_blank" rel="noopener">SHARE YOUR ESSAINT LOOK ↗</a></div></section>{% schema %}{"name": "In the Wild", "settings": [], "max_blocks": 10, "blocks": [{"type": "photo", "name": "Photo card", "settings": [{"type": "image_picker", "id": "image", "label": "Photo"}, {"type": "product", "id": "product", "label": "Featured product"}, {"type": "text", "id": "caption", "label": "Caption", "default": "Everyday Essaint"}, {"type": "text", "id": "asset", "label": "Fallback theme image", "default": "wild-1.jpg"}]}], "presets": [{"name": "In the Wild"}]}{% endschema %}