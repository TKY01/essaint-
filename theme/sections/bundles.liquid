<section class="bundle-section bundle-section--soft" id="bundles"><div class="bundle-intro"><p class="eyebrow">COMPLETE THE LOOK</p><h2>Pants + Tee.<br><em>Better together.</em></h2><p>Pair any tee with your favorite trousers. A full look, your way.</p></div><div class="studio" data-studio><div class="studio-visual"><div class="studio-stamp">ESSAINT<br><span>YOUR EVERYDAY PAIRING.</span></div><div class="studio-images"><div><img data-studio-image="top" src="{{ 'over-size-t-shirt-0.jpg' | asset_url }}" width="566" height="512" alt="Oversized T-Shirt"><span>01 / THE TOP</span></div><span class="studio-plus">+</span><div><img data-studio-image="bottom" src="{{ 'milano-striped-pants-dropping-next-week-0.png' | asset_url }}" width="1023" height="1276" alt="Milano Striped Pants"><span>02 / THE BOTTOM</span></div></div><div class="studio-caption"><span>TWO PIECES. ONE POINT OF VIEW.</span><span>01 + 02</span></div></div><form class="studio-form"><p class="eyebrow">MAKE IT A SET</p><h3>Make it yours.</h3><div class="studio-step"><div class="step-label"><span>01</span><label for="studio-top-{{ section.id }}">CHOOSE YOUR TOP</label></div><select id="studio-top-{{ section.id }}" data-studio-product="top">{% assign tops = section.settings.tops | default: collections.all %}{% for item in tops.products %}{% assign lower = item.title | downcase %}{% if lower contains 't-shirt' %}<option value="{{ item.handle }}" {% if item.handle == 'over-size-t-shirt' %}selected{% endif %}>{{ item.title }}</option>{% endif %}{% endfor %}</select><label class="variant-label" for="studio-top-variant-{{ section.id }}">SIZE / COLOR</label><select id="studio-top-variant-{{ section.id }}" data-studio-variant="top" disabled><option>Choose a piece to see available options</option></select></div><div class="studio-step"><div class="step-label"><span>02</span><label for="studio-bottom-{{ section.id }}">CHOOSE YOUR BOTTOM</label></div><select id="studio-bottom-{{ section.id }}" data-studio-product="bottom">{% assign bottoms = section.settings.bottoms | default: collections.all %}{% for item in bottoms.products %}{% assign lower = item.title | downcase %}{% unless lower contains 't-shirt' %}<option value="{{ item.handle }}" {% if item.handle == 'milano-striped-pants-dropping-next-week' %}selected{% endif %}>{{ item.title }}</option>{% endunless %}{% endfor %}</select><label class="variant-label" for="studio-bottom-variant-{{ section.id }}">SIZE / COLOR</label><select id="studio-bottom-variant-{{ section.id }}" data-studio-variant="bottom" disabled><option>Choose a piece to see available options</option></select></div><div class="studio-total"><span>YOUR SET TOTAL</span><strong data-studio-total>—</strong></div><button class="button" data-studio-add disabled>ADD THE FULL FIT <span>↗</span></button><p class="studio-note" data-studio-message>Pick your pieces. Select your fit. We'll do the rest.</p><noscript><p>Enable JavaScript to build a set, or shop each product individually.</p></noscript></form></div><div class="preset-row"><span>NEED A STARTING POINT?</span>{% for block in section.blocks %}{% assign top = block.settings.top %}{% assign bottom = block.settings.bottom %}{% if top != blank and bottom != blank %}<button {{ block.shopify_attributes }} data-studio-preset="{{ top.handle }},{{ bottom.handle }}">{{ block.settings.title }} ↗</button>{% endif %}{% endfor %}</div></section>
{% schema %}{"name": "Bundles", "settings": [{"type": "collection", "id": "tops", "label": "Tops collection"}, {"type": "collection", "id": "bottoms", "label": "Bottoms collection"}], "presets": [{"name": "Bundles"}], "max_blocks": 3, "blocks": [{"type": "outfit", "name": "Suggested outfit", "settings": [{"type": "text", "id": "title", "label": "Title", "default": "The striped set"}, {"type": "product", "id": "top", "label": "Top"}, {"type": "product", "id": "bottom", "label": "Bottom"}]}]}{% endschema %}