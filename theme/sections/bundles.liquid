<section class="section bundle-section" id="bundles"><div class="section-heading"><div><p class="eyebrow">BETTER TOGETHER</p><h2>A whole look.<br>One easy decision.</h2></div><p>Good pieces make great pairs.<br>Choose your fit. Make it your own.</p></div><div class="bundle-grid">{% for block in section.blocks %}{% assign top = block.settings.top %}{% assign bottom = block.settings.bottom %}{% if top != blank and bottom != blank %}<article class="bundle-card" {{ block.shopify_attributes }}><div class="bundle-images">{{ top.featured_image | image_url: width: 700 | image_tag: loading: 'lazy' }}{{ bottom.featured_image | image_url: width: 700 | image_tag: loading: 'lazy' }}<span class="bundle-number">0{{ forloop.index }} / THE OUTFIT EDIT</span></div><div class="bundle-info"><div><h3>{{ block.settings.title }}</h3><p>{{ top.title }} + {{ bottom.title }}</p></div><button class="text-link" data-bundle="{{ top.handle }},{{ bottom.handle }}" data-title="{{ block.settings.title | escape }}">Build your set ↗</button></div></article>{% endif %}{% endfor %}</div></section>{% schema %}{"name": "Outfit bundles", "max_blocks": 3, "settings": [], "blocks": [{"type": "outfit", "name": "Outfit", "settings": [{"type": "text", "id": "title", "label": "Title", "default": "The daily uniform"}, {"type": "product", "id": "top", "label": "First piece"}, {"type": "product", "id": "bottom", "label": "Second piece"}]}], "presets": [{"name": "Outfit bundles"}]}{% endschema %}