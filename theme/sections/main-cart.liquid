<section class="section cart-page"><p class="eyebrow">YOUR EVERYDAY STARTS HERE</p><h1>Your bag.</h1>{% if cart.empty? %}<p>Your bag is waiting for something good.</p><a class="button" href="{{ routes.all_products_collection_url }}">Explore the collection ↗</a>{% else %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-row">{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy' }}<div><a href="{{ item.url }}">{{ item.product.title }}</a><p>{{ item.variant.title }}</p><a href="{{ item.url_to_remove }}">Remove</a></div><label>Quantity<input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.title | escape }}"></label><span>{{ item.final_line_price | money }}</span></div>{% endfor %}<p>Subtotal {{ cart.total_price | money }}</p>{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title }} −{{ discount.total_allocated_amount | money }}</p>{% endfor %}<p>Shipping and taxes calculated at checkout.</p><button class="text-link" name="update">Update bag</button><button class="button" name="checkout">Checkout ↗</button></form>{% endif %}</section>
{% schema %}{"name": "Main Cart", "settings": [], "presets": [{"name": "Main Cart"}]}{% endschema %}