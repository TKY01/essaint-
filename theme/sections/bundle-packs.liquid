<section class="pack-section" id="bundles" data-pack><div class="refined-heading"><p class="eyebrow">MORE OF WHAT YOU LIVE IN</p><h2>Build a bundle.</h2><p>Choose your favorite piece. Pick your pack.<br>Make every color and size your own.</p></div><div class="pack-card"><div class="pack-product-bar"><div><label for="pack-product-{{ section.id }}">SELECT YOUR PRODUCT</label><select id="pack-product-{{ section.id }}" data-pack-product>{% assign pack_collection = section.settings.collection | default: collections.all %}{% for item in pack_collection.products %}<option value="{{ item.handle }}" {% if item.handle == 'over-size-t-shirt' %}selected{% endif %}>{{ item.title }}</option>{% endfor %}</select></div><a class="text-link" data-pack-link href="{{ routes.all_products_collection_url }}">VIEW PRODUCT ↗</a></div><div class="pack-main"><div class="pack-media"><div class="pack-stage"><img data-pack-image src="{{ 'over-size-t-shirt-0.jpg' | asset_url }}" alt="Oversized T-Shirt" width="566" height="512" loading="lazy"><span data-pack-badge>YOUR 3-PIECE PACK</span></div><p data-pack-title>Oversized T-Shirt</p><div class="pack-thumbs" data-pack-thumbs></div></div><form class="pack-panel"><fieldset class="pack-quantity"><legend>01 / CHOOSE YOUR QUANTITY</legend><div class="pack-tiers">{% for count in (1..3) %}{% case count %}{% when 1 %}{% assign qty = 1 %}{% when 2 %}{% assign qty = 3 %}{% when 3 %}{% assign qty = 6 %}{% endcase %}<button type="button" data-pack-qty="{{ qty }}" aria-pressed="{% if qty == 3 %}true{% else %}false{% endif %}" {% if qty == 3 %}class="active"{% endif %}><strong>{{ qty }}</strong><span>{% if qty == 1 %}THE SINGLE{% elsif qty == 3 %}THE ROTATION{% else %}THE FULL WEEK{% endif %}</span><small data-tier-price>—</small></button>{% endfor %}</div></fieldset><div class="pack-pieces-heading"><span>02 / CONFIGURE EACH PIECE</span><span data-pack-count>3 PIECES</span></div><div data-pack-pieces><p>Loading available sizes and colors…</p></div><div class="pack-checkout"><div class="pack-price"><strong data-pack-total>—</strong><span data-pack-each></span></div><button class="button" data-pack-add disabled>ADD YOUR BUNDLE <span>↗</span></button><p class="pack-message" data-pack-message role="status">Choose your options to build your pack.</p></div><noscript><p>Enable JavaScript to build a pack, or shop products individually.</p></noscript></form></div></div></section>{% schema %}{"name": "Product packs", "settings": [{"type": "collection", "id": "collection", "label": "Products available for packs"}], "presets": [{"name": "Product packs"}]}{% endschema %}