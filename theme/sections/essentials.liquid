<section class="section" id="essentials"><div class="section-heading"><div><p class="eyebrow">THE ROTATION, REFINED</p><h2>Your new regulars.</h2></div><a class="text-link" href="{{ routes.all_products_collection_url }}">Explore all pieces ↗</a></div><div class="product-grid">{% assign featured = section.settings.collection | default: collections.all %}{% for product in featured.products limit: 4 %}{% render 'product-card', product: product %}{% endfor %}</div></section>
{% schema %}{"name": "Essentials", "settings": [{"type": "collection", "id": "collection", "label": "Featured collection"}], "presets": [{"name": "Essentials"}]}{% endschema %}