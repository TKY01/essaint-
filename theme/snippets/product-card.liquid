<article class="product-card"><a class="product-photo" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,500,700,900', sizes: '(min-width: 900px) 25vw, 50vw' }}{% endif %}{% if product.images[1] %}{{ product.images[1] | image_url: width: 900 | image_tag: loading: 'lazy', class: 'alternate' }}{% endif %}<span class="badge">{% unless product.available %}Sold out{% else %}{% if product.compare_at_price > product.price %}The good-price edit{% endif %}{% endunless %}</span></a><button class="quick-add" data-product="{{ product.handle }}" aria-label="Choose options for {{ product.title | escape }}">+</button><div class="product-meta"><a href="{{ product.url }}">{{ product.title }}</a><span>{{ product.price | money }}{% if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif %}</span></div><p class="product-options">{{ product.options_with_values.first.values | join: ' · ' }}</p></article>